NODE_ENV=development
PORT=3001
DATABASE_URL="postgresql://hubdesk:hubdesk@localhost:5432/hubdesk?schema=public"
JWT_SECRET="change-me-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
UPLOADS_DIR="uploads"

# Opcional: usadas por `npm run db:seed` para criar o primeiro usuário ADMIN.
# O seed só roda se ainda não existir nenhum ADMIN no banco (idempotente).
# Se SEED_ADMIN_PASSWORD não for definida, uma senha aleatória forte é gerada
# e impressa no console UMA ÚNICA VEZ — anote-a, ela não é salva em lugar nenhum.
# SEED_ADMIN_NAME="Admin"
# SEED_ADMIN_EMAIL="admin@hubdesk.local"
# SEED_ADMIN_PASSWORD=""

CLIENT_URL="http://localhost:3000"
