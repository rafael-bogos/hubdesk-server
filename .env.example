NODE_ENV=development
PORT=3001
DATABASE_URL="postgresql://hubdesk:hubdesk@localhost:5432/hubdesk?schema=public"
JWT_SECRET="change-me-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
UPLOADS_DIR="uploads"

# Opcional: usadas por `npm run db:seed` para criar o primeiro usuário ADMIN.
# O seed só roda se ainda não existir nenhum ADMIN no banco (idempotente).
# Se SEED_ADMIN_PASSWORD não for definida, uma senha aleatória forte é gerada
# e impressa no console UMA ÚNICA VEZ — anote-a, ela não é salva em lugar nenhum.
# SEED_ADMIN_NAME="Admin"
# SEED_ADMIN_EMAIL="admin@hubdesk.local"
# SEED_ADMIN_PASSWORD=""

CLIENT_URL="http://localhost:3000"

# Redis usado pela fila do BullMQ (fechamento automático de chamados em
# PENDING_CLOSURE). Ver docker-compose.dev.yml.
REDIS_URL="redis://localhost:6381"

# Login configurável (Google / OAuth customizado) via better-auth.
BACKEND_PUBLIC_URL="http://localhost:3001"
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=""
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_ENCRYPTION_KEY=""
