generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AGENT
  CUSTOMER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  // Default "" (nunca um hash bcrypt válido) pra permitir usuários criados
  // via OAuth pelo better-auth, que não passam senha nenhuma no create —
  // bcrypt.compare contra "" sempre dá false, então login por senha some
  // sozinho pra essas contas, sem precisar mexer no use case de login.
  passwordHash String   @default("") @map("password_hash")
  role         Role     @default(CUSTOMER)
  tokenVersion Int      @default(0) @map("token_version")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  // Campos exigidos pelo better-auth (login via Google / OAuth customizado) —
  // ver infrastructure/auth/better-auth-instance.ts. `emailVerified` de
  // usuários já existentes é retroativamente marcado true na migration (eles
  // já passaram pelo nosso próprio registro), o que habilita account linking
  // automático se um dia logarem via OAuth com o mesmo e-mail.
  emailVerified Boolean @default(false) @map("email_verified")
  image         String?

  // Preferências de e-mail, independentes uma da outra — quem não quer ser
  // avisado a cada atualização ainda pode querer saber quando o chamado
  // fecha, por exemplo.
  emailOnTicketUpdated Boolean @default(true) @map("email_on_ticket_updated")
  emailOnTicketClosed  Boolean @default(true) @map("email_on_ticket_closed")
  emailOnSlaWarning    Boolean @default(true) @map("email_on_sla_warning")

  ticketsRequested   Ticket[]         @relation("TicketRequester")
  ticketAssignments  TicketAssignee[]
  comments           Comment[]
  attachments        Attachment[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  accounts           Account[]
  sessions           Session[]

  @@map("users")
}

// A partir daqui: tabelas próprias do better-auth (login via Google / OAuth
// customizado) — nomes/campos vêm do schema padrão dele (conferido rodando
// `getSchema()` da versão instalada, não adivinhado). Usadas só internamente
// pelo better-auth; a API do Hubdesk continua emitindo seu próprio JWT depois
// que ele confirma quem é o usuário (ver infrastructure/auth).
model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("accounts")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verifications")
}

// Configuração única (uma linha, id fixo) de quais métodos de login estão
// habilitados — editada pelo admin em /admin/login-settings. Client secrets
// ficam cifrados (ver infrastructure/crypto/secret-cipher.ts), nunca em texto
// puro no banco.
model LoginSettings {
  id                                String   @id @default("singleton")
  emailPasswordEnabled              Boolean  @default(true) @map("email_password_enabled")
  googleEnabled                     Boolean  @default(false) @map("google_enabled")
  googleClientId                    String?  @map("google_client_id")
  googleClientSecretEncrypted       String?  @map("google_client_secret_encrypted")
  customOAuthEnabled                Boolean  @default(false) @map("custom_oauth_enabled")
  customOAuthProviderId             String?  @map("custom_oauth_provider_id")
  customOAuthProviderName           String?  @map("custom_oauth_provider_name")
  customOAuthClientId               String?  @map("custom_oauth_client_id")
  customOAuthClientSecretEncrypted  String?  @map("custom_oauth_client_secret_encrypted")
  customOAuthAuthorizationUrl       String?  @map("custom_oauth_authorization_url")
  customOAuthTokenUrl               String?  @map("custom_oauth_token_url")
  customOAuthUserInfoUrl            String?  @map("custom_oauth_user_info_url")
  customOAuthScopes                 String?  @map("custom_oauth_scopes")
  // Usados só pra verificar a assinatura de um `logout_token` de back-channel
  // logout (ver application/use-cases/auth/handle-backchannel-logout.use-case.ts)
  // — opcionais: sem eles, o back-channel logout desse provedor simplesmente
  // não valida nada (login/logout normal continuam funcionando de qualquer jeito).
  customOAuthIssuer                 String?  @map("custom_oauth_issuer")
  customOAuthJwksUrl                String?  @map("custom_oauth_jwks_url")
  // Logo do botão do OAuth customizado (Google já tem o ícone padrão dele
  // embutido) — path no FileStorage, igual aos anexos de chamado. Sem logo
  // enviada, a tela de login cai num ícone genérico.
  customOAuthLogoPath               String?  @map("custom_oauth_logo_path")
  customOAuthLogoMimeType           String?  @map("custom_oauth_logo_mime_type")
  // "google" | "custom" | "email" — qual método aparece em destaque na tela
  // de login.
  defaultMethod                     String   @default("google") @map("default_method")
  updatedAt                         DateTime @updatedAt @map("updated_at")

  @@map("login_settings")
}

// Configuração única (uma linha, id fixo) do prazo de SLA por prioridade —
// editada pelo admin em /admin/sla-settings. Ver application/services/sla-calculator.ts
// pra como as horas viram um prazo de verdade por chamado.
model SlaSettings {
  id                      String   @id @default("singleton")
  lowPriorityHours        Int      @default(72) @map("low_priority_hours")
  mediumPriorityHours     Int      @default(24) @map("medium_priority_hours")
  highPriorityHours       Int      @default(8) @map("high_priority_hours")
  urgentPriorityHours     Int      @default(4) @map("urgent_priority_hours")
  // % do prazo consumido a partir do qual um chamado é considerado "perto de
  // estourar" (dispara indicador + notificação).
  warningThresholdPercent Int      @default(80) @map("warning_threshold_percent")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("sla_settings")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  // Aguardando o prazo de fechamento automático (ver TicketClosureScheduler) —
  // ainda não é RESOLVED, mas vira sozinho quando `scheduledClosureAt` chega,
  // a menos que alguém troque o status antes disso.
  PENDING_CLOSURE
  RESOLVED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Category {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tickets Ticket[]

  @@map("categories")
}

model Ticket {
  id          String         @id @default(cuid())
  number      Int            @unique @default(autoincrement())
  title       String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)

  requesterId String @map("requester_id")
  requester   User   @relation("TicketRequester", fields: [requesterId], references: [id])

  assignees TicketAssignee[]

  categoryId String?   @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  closedAt  DateTime? @map("closed_at")
  // Só preenchido enquanto status = PENDING_CLOSURE — quando o job do BullMQ
  // roda (ou o status muda antes disso), volta a null.
  scheduledClosureAt DateTime? @map("scheduled_closure_at")

  // SLA (ver application/services/sla-calculator.ts): o prazo em si não é
  // armazenado (é sempre recalculado a partir de createdAt/priority/settings),
  // só o que não dá pra derivar — o relógio pausado e o dedupe do aviso.
  // Setado ao entrar em WAITING, null fora disso (ainda pausado agora).
  slaPausedAt DateTime? @map("sla_paused_at")
  // Soma de pausas já concluídas (ms) — não inclui a pausa em andamento.
  slaPausedDurationMs Int @default(0) @map("sla_paused_duration_ms")
  // Evita reenviar o aviso de "perto de estourar" a cada varredura do job.
  // Resetado pra null quando a prioridade muda (novo alvo de SLA).
  slaWarningNotifiedAt DateTime? @map("sla_warning_notified_at")

  comments      Comment[]
  attachments   Attachment[]
  notifications Notification[]

  @@index([status])
  @@map("tickets")
}

model TicketAssignee {
  id       String @id @default(cuid())
  ticketId String @map("ticket_id")
  ticket   Ticket @relation(fields: [ticketId], references: [id])
  userId   String @map("user_id")
  user     User   @relation(fields: [userId], references: [id])

  assignedAt DateTime @default(now()) @map("assigned_at")

  @@unique([ticketId, userId])
  @@map("ticket_assignees")
}

model Comment {
  id         String  @id @default(cuid())
  ticketId   String  @map("ticket_id")
  ticket     Ticket  @relation(fields: [ticketId], references: [id])
  authorId   String  @map("author_id")
  author     User    @relation(fields: [authorId], references: [id])
  body       String
  isInternal Boolean @default(false) @map("is_internal")

  createdAt DateTime @default(now()) @map("created_at")

  attachments Attachment[]

  @@map("comments")
}

model Attachment {
  id       String @id @default(cuid())
  ticketId String @map("ticket_id")
  ticket   Ticket @relation(fields: [ticketId], references: [id])

  commentId String?  @map("comment_id")
  comment   Comment? @relation(fields: [commentId], references: [id])

  filename String
  path     String
  mimeType String @map("mime_type")
  size     Int

  uploadedById String @map("uploaded_by_id")
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  isInternal Boolean @default(false) @map("is_internal")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("attachments")
}

model Notification {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // String em vez de enum: mais barato adicionar tipos novos sem migration.
  type  String
  title String
  body  String

  ticketId     String @map("ticket_id")
  ticket       Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // Denormalizado de propósito — a notificação não deve mudar de conteúdo se
  // o chamado for atualizado de novo depois, e evita um join só pra listar.
  ticketNumber Int    @map("ticket_number")

  read Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

model AuditLog {
  id       String @id @default(cuid())
  actorId  String @map("actor_id")
  actor    User   @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action   String
  entity   String
  entityId String @map("entity_id")
  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}
